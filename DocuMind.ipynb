import os
import torch
import gradio as gr
import numpy as np
import faiss

from pypdf import PdfReader
from sentence_transformers import SentenceTransformer
from transformers import AutoTokenizer, AutoModelForSeq2SeqLM


EMBEDDING_MODEL_NAME = "sentence-transformers/all-MiniLM-L6-v2"
GENERATION_MODEL_NAME = "google/flan-t5-base"

DEVICE = "cuda" if torch.cuda.is_available() else "cpu"

print("Running on:", DEVICE)


print("Loading embedding model...")

embedding_model = SentenceTransformer(
    EMBEDDING_MODEL_NAME,
    device=DEVICE
)

print("Loading answer-generation model...")

tokenizer = AutoTokenizer.from_pretrained(
    GENERATION_MODEL_NAME
)

generator_model = AutoModelForSeq2SeqLM.from_pretrained(
    GENERATION_MODEL_NAME
).to(DEVICE)

generator_model.eval()

print("Models loaded successfully!")


document_chunks = []
document_sources = []
faiss_index = None

def extract_text_from_pdf(pdf_path):

    reader = PdfReader(pdf_path)

    extracted_pages = []

    for page_number, page in enumerate(
        reader.pages,
        start=1
    ):

        text = page.extract_text()

        if text and text.strip():

            extracted_pages.append({
                "page": page_number,
                "text": text.strip()
            })

    return extracted_pages


def split_text(
    text,
    chunk_size=180,
    overlap=40
):

    words = text.split()

    chunks = []

    start = 0

    while start < len(words):

        end = start + chunk_size

        chunk = " ".join(
            words[start:end]
        )

        if chunk.strip():
            chunks.append(chunk)

        start += chunk_size - overlap

    return chunks

def process_pdfs(files):

    global document_chunks
    global document_sources
    global faiss_index

    document_chunks = []
    document_sources = []
    faiss_index = None

    if not files:

        return "Please upload at least one PDF."

    successful_files = 0
    failed_files = []

    for file in files:

        pdf_path = (
            file.name
            if hasattr(file, "name")
            else file
        )

        try:

            pages = extract_text_from_pdf(
                pdf_path
            )

            file_chunks = []

            for page_data in pages:

                page_number = page_data["page"]
                page_text = page_data["text"]

                chunks = split_text(
                    page_text
                )

                for chunk in chunks:

                    file_chunks.append({
                        "text": chunk,
                        "filename": os.path.basename(
                            pdf_path
                        ),
                        "page": page_number
                    })

            if file_chunks:

                successful_files += 1

                for item in file_chunks:

                    document_chunks.append(
                        item["text"]
                    )

                    document_sources.append({
                        "filename": item["filename"],
                        "page": item["page"]
                    })

            else:

                failed_files.append(
                    os.path.basename(pdf_path)
                    + " (no readable text)"
                )

        except Exception as error:

            failed_files.append(
                os.path.basename(pdf_path)
                + f" ({str(error)})"
            )

    if not document_chunks:

        return (
            "No readable text was extracted.\n"
            "The PDF may be scanned or image-based. "
            "OCR may be required."
        )

    print("Creating embeddings...")

    embeddings = embedding_model.encode(
        document_chunks,
        convert_to_numpy=True,
        normalize_embeddings=True,
        show_progress_bar=False
    )

    embeddings = embeddings.astype(
        np.float32
    )

    dimension = embeddings.shape[1]

    faiss_index = faiss.IndexFlatIP(
        dimension
    )

    faiss_index.add(
        embeddings
    )

    status = (
        f"Successfully processed {successful_files} PDF(s).\n"
        f"Total text chunks: {len(document_chunks)}.\n"
        "You can now ask questions."
    )

    if failed_files:

        status += (
            "\n\nFiles that could not be processed:\n"
            + "\n".join(failed_files)
        )

    return status


def retrieve_relevant_chunks(
    question,
    top_k=4
):

    if (
        faiss_index is None
        or not document_chunks
    ):

        return []

    question_embedding = embedding_model.encode(
        [question],
        convert_to_numpy=True,
        normalize_embeddings=True
    ).astype(np.float32)

    number_of_results = min(
        top_k,
        len(document_chunks)
    )

    scores, indices = faiss_index.search(
        question_embedding,
        number_of_results
    )

    results = []

    for score, index in zip(
        scores[0],
        indices[0]
    ):

        if index < 0:
            continue

        results.append({
            "text": document_chunks[index],
            "source": document_sources[index],
            "score": float(score)
        })

    return results


def generate_answer(
    question,
    context
):

    prompt = f"""
You are DocuMind, an assistant that answers questions
about uploaded documents.

Use ONLY the information in the context below.

Rules:
- Answer the exact question.
- Do not answer a different question.
- Do not use outside knowledge.
- Do not invent facts, names, dates, or numbers.
- If the context does not contain the answer,
  respond with NOT_FOUND.
- Keep the answer clear and direct.

Context:
{context}

Question:
{question}

Answer:
"""

    inputs = tokenizer(
        prompt,
        return_tensors="pt",
        truncation=True,
        max_length=512
    )

    inputs = {
        key: value.to(DEVICE)
        for key, value in inputs.items()
    }

    with torch.no_grad():

        output = generator_model.generate(
            **inputs,
            max_new_tokens=120,
            num_beams=4,
            do_sample=False,
            repetition_penalty=1.2
        )

    answer = tokenizer.decode(
        output[0],
        skip_special_tokens=True
    )

    return answer.strip()


def answer_question(question):

    if not question or not question.strip():

        return (
            "Please enter a question.",
            ""
        )

    if faiss_index is None:

        return (
            "Please upload and process your PDFs first.",
            ""
        )

    results = retrieve_relevant_chunks(
        question,
        top_k=4
    )

    if not results:

        return (
            "No relevant information was found.",
            ""
        )

    # Similarity is a retrieval signal, not proof
    # that a passage answers the question.
    best_score = results[0]["score"]

    MIN_SIMILARITY = 0.30

    if best_score < MIN_SIMILARITY:

        return (
            "I could not find sufficiently relevant "
            "information in your uploaded documents. "
            "Try rephrasing your question.",
            ""
        )

    # Use the best matching passages.
    relevant_results = [
        item
        for item in results
        if item["score"] >= max(
            MIN_SIMILARITY,
            best_score - 0.15
        )
    ][:3]

    context_parts = []
    source_lines = []

    for item in relevant_results:

        source = item["source"]

        context_parts.append(
            f"[Source: {source['filename']}, "
            f"Page {source['page']}]\n"
            f"{item['text']}"
        )

        source_lines.append(
            f"{source['filename']} | "
            f"Page {source['page']} | "
            f"Similarity: {item['score']:.3f}"
        )

    context = "\n\n".join(
        context_parts
    )

    answer = generate_answer(
        question,
        context
    )

    # Handle missing or unusable answers.
    if (
        not answer
        or "NOT_FOUND" in answer.upper()
    ):

        return (
            "The uploaded documents do not contain "
            "enough information to answer this question.",
            "\n".join(source_lines)
        )

    return (
        answer,
        "\n".join(source_lines)
    )


with gr.Blocks(
    title="DocuMind - AI PDF Assistant"
) as demo:

    gr.Markdown(
        """
        # 📚 DocuMind
        ## AI-Powered PDF Research Assistant

        Upload research papers, notes, reports, or other PDFs.
        Ask questions and get answers based on the documents.
        """
    )

    with gr.Row():

        with gr.Column():

            pdf_upload = gr.File(
                label="Upload PDF Documents",
                file_count="multiple",
                file_types=[".pdf"],
                type="filepath"
            )

            process_button = gr.Button(
                "Process Documents",
                variant="primary"
            )

            processing_status = gr.Textbox(
                label="Processing Status",
                lines=5,
                interactive=False
            )

        with gr.Column():

            question_input = gr.Textbox(
                label="Ask a Question",
                placeholder=(
                    "Example: What are the main findings "
                    "of this research paper?"
                ),
                lines=3
            )

            ask_button = gr.Button(
                "Ask DocuMind",
                variant="primary"
            )

    answer_output = gr.Textbox(
        label="Answer",
        lines=8,
        interactive=False
    )

    sources_output = gr.Textbox(
        label="Retrieved Sources",
        lines=5,
        interactive=False
    )

    process_button.click(
        fn=process_pdfs,
        inputs=[pdf_upload],
        outputs=[processing_status]
    )

    ask_button.click(
        fn=answer_question,
        inputs=[question_input],
        outputs=[
            answer_output,
            sources_output
        ]
    )

    question_input.submit(
        fn=answer_question,
        inputs=[question_input],
        outputs=[
            answer_output,
            sources_output
        ]
    )


demo.queue().launch(
    share=True,
    debug=True
)
